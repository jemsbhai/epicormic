# epicormic needs no credentials of its own. It never constructs provider
# clients: the step callable passed as --fn (or fn=) owns them, exactly as
# in pollard. The variables below are placeholders for the example step
# modules and for EXP-D only. Copy this file to .env and fill in locally;
# .env is ignored by git.

# OpenAI Responses API (examples/steps_openai.py)
OPENAI_API_KEY=

# Anthropic Messages API (examples/steps_anthropic.py)
ANTHROPIC_API_KEY=

# Amazon Bedrock Converse (examples/steps_bedrock.py); the AWS SDK reads the
# usual credential chain, so a named profile is enough.
AWS_PROFILE=
AWS_REGION=

# LiteLLM route (examples/steps_litellm.py): whichever provider variables the
# chosen route requires, for example VERTEXAI_PROJECT or AZURE_API_KEY.
